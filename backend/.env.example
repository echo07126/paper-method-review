APP_ENV=dev
DEBUG=true
DOCS_ENABLED=true
ALLOWED_ORIGINS=http://localhost:5173
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=3
LLM_MAX_CONCURRENCY=2
LLM_DEFAULT_ENABLED=true
LLM_VERIFY_ENABLED=true
LLM_VERIFY_MAX_ITEMS=6
LLM_ADVISORY_ONLY=true
DEMOTE_ON_FIGURES=false
MAX_UPLOAD_MB=50
MAX_PAGES=60
SESSION_TTL_HOURS=2
DATA_RETENTION_HOURS=2
DB_PATH=./data/app.db
TEMP_DIR=./data/tmp
CHECKLIST_DIR=../checklists
