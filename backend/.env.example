APP_ENV=dev
DEBUG=true
DOCS_ENABLED=true
ALLOWED_ORIGINS=http://localhost:5173
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=3
LLM_MAX_CONCURRENCY=2
LLM_DEFAULT_ENABLED=true
LLM_VERIFY_ENABLED=true
LLM_VERIFY_MAX_ITEMS=6
# L3 图像内容识读（P2-3）：按张计费，关闭后不产生视觉调用
LLM_VISION_ENABLED=true
LLM_VISION_MAX_IMAGES=4
LLM_ADVISORY_ONLY=true
DEMOTE_ON_FIGURES=false
# 追问多轮上下文上限（需求 15.5.4）：10 轮 / 20 条消息 + 历史总字符 8000（含 system）
CHAT_HISTORY_MAX_TURNS=10
CHAT_HISTORY_MAX_CHARS=8000
MAX_UPLOAD_MB=50
MAX_PAGES=60
SESSION_TTL_HOURS=2
DATA_RETENTION_HOURS=2
DB_PATH=./data/app.db
TEMP_DIR=./data/tmp
CHECKLIST_DIR=../checklists
