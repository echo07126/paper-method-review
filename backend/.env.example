APP_ENV=dev
DEBUG=true
DOCS_ENABLED=true
ALLOWED_ORIGINS=http://localhost:5173
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=3
LLM_MAX_CONCURRENCY=4
LLM_DEFAULT_ENABLED=true
LLM_VERIFY_ENABLED=true
LLM_VERIFY_MAX_ITEMS=6
# L3 图像内容识读（P2-3）：按张计费，关闭后不产生视觉调用
LLM_VISION_ENABLED=true
LLM_VISION_MAX_IMAGES=4
# 全局顾问模式（安全阀）：true 时所有模型结论一律降级为「存疑」。
# 默认 false —— 判定权按清单条目的 judge 字段分权（advisory 档单独降级）。
LLM_ADVISORY_ONLY=false
# 高级应用：按要素定向送审（每条清单只带相关原文片段）
LLM_DIRECTED_REVIEW=true
# 高级应用：双模型互证（同题两跑，分歧降级为存疑）
LLM_DUAL_CHECK=false
DEMOTE_ON_FIGURES=false
# 重接口任务队列：POST 立即返回 202 + task_id，前端轮询 /api/v1/tasks/{task_id}
TASK_MAX_WORKERS=2
TASK_RETENTION_MINUTES=30
# 追问多轮上下文上限（需求 15.5.4）：10 轮 / 20 条消息 + 历史总字符 8000（含 system）
CHAT_HISTORY_MAX_TURNS=10
CHAT_HISTORY_MAX_CHARS=8000
# 自由提问（全文问答）注入全文的字符预算，超出按整段裁剪
QA_FULLTEXT_MAX_CHARS=12000
# 全文注入链路的统一提示词预算（审查 / 引用核验 / 补写共用）。
# 0 = 使用 engine/prompts.MAX_PROMPT_CHARS（12000）；设为正数可全局覆盖。
PROMPT_MAX_CHARS=0
# 定向送审提示词预算：0 = 不限制（默认）。规模上限约「条目数 × 6 片段 × 600 字」，
# 长清单 + 长文档时 token 成本显著；设为正数即按「条目块」从尾部裁剪。
DIRECTED_MAX_CHARS=0
MAX_UPLOAD_MB=50
MAX_PAGES=60
SESSION_TTL_HOURS=2
DATA_RETENTION_HOURS=2
DB_PATH=./data/app.db
TEMP_DIR=./data/tmp
CHECKLIST_DIR=../checklists
