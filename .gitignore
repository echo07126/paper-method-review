# 密钥与本地配置
.env
**/.env
!.env.example

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
*.egg-info/

# --- P0 合规：禁止入库的材料 ---
# 用户提供的原始论文（非开放许可）及其衍生产物
samples/real/raw/
# 从用户论文中抽取的插图（派生于原始论文，同样不得入库）
samples/real/*_media/
# 评测样本目录下任何随审查生成的媒体落盘产物
**/_media/

# --- 测试临时产物 ---
.pytest-tmp/
.pytest_cache/
# 运行时数据（论文/报告/临时文件不得入库）
data/
logs/
*.db
*.sqlite3

# 前端
node_modules/
dist/
*.timestamp-*.mjs
.vite/

# 编辑器与系统
.idea/
.vscode/
.DS_Store
Thumbs.db
